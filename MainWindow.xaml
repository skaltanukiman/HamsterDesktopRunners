<Window x:Class="HamsterDesktopRunners.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HamsterDesktopRunners Launcher" Height="640" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closing="Window_Closing"
        Background="Transparent"
        AllowsTransparency="False">

    <Window.Resources>
        <!-- カラー定義 -->
        <Color x:Key="PrimaryColor">#FF6B35</Color>
        <Color x:Key="PrimaryDarkColor">#E5552A</Color>
        <Color x:Key="AccentColor">#FFB347</Color>
        <Color x:Key="DangerColor">#E74C3C</Color>
        <Color x:Key="DangerDarkColor">#C0392B</Color>
        <Color x:Key="SuccessColor">#2ECC71</Color>
        <Color x:Key="SuccessDarkColor">#27AE60</Color>
        <Color x:Key="CardBgColor">#FFFAF5</Color>
        <Color x:Key="TextColor">#3D2B1F</Color>
        <Color x:Key="SubTextColor">#8B7355</Color>

        <!-- メインボタンスタイル（オレンジ） -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,8"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.25" Color="#FF6B35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFCC66" Offset="0"/>
                                            <GradientStop Color="#FF7F45" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="3" BlurRadius="10" Opacity="0.35" Color="#FF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource PrimaryDarkColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#D5C4A1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#A89880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 停止ボタンスタイル（レッド） -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6B6B" Offset="0"/>
                        <GradientStop Color="{StaticResource DangerColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,8"
                                BorderThickness="0">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="2" BlurRadius="6" Opacity="0.2" Color="#E74C3C"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF8080" Offset="0"/>
                                            <GradientStop Color="#F75050" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#D5C4A1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#A89880"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- セカンダリボタンスタイル（アウトライン） -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF6B35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="12,8"
                                BorderBrush="#FFD4A8" BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.1" Color="#999"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FFF5EB"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF6B35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#F0E8DD"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#B8A890"/>
                                <Setter TargetName="border" Property="BorderBrush">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#E0D5C5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- メイン背景 -->
    <Border CornerRadius="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFF8F0" Offset="0"/>
                <GradientStop Color="#FFE8D6" Offset="0.5"/>
                <GradientStop Color="#FDD5B1" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトル部分 -->
            <Border Grid.Row="0" Margin="0,0,0,18" Padding="0,8">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🐹" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Hamster Desktop Runners" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#3D2B1F"/>
                    <TextBlock Text="デスクトップを走り回るハムスター" FontSize="11"
                               HorizontalAlignment="Center" Foreground="#8B7355" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- ディスプレイ選択カード -->
            <Border Grid.Row="1" Background="#FFFAF5" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Color="#A0522D"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5D4037" Margin="0,0,0,6">
                        <Run Text="🖥️ "/>
                        <Run Text="走らせるディスプレイ"/>
                    </TextBlock>
                    <ComboBox x:Name="CmbScreens" Height="32" FontSize="13" SelectedIndex="0"
                              SelectionChanged="CmbScreens_SelectionChanged"/>
                </StackPanel>
            </Border>

            <!-- ハムスター種類カード -->
            <Border Grid.Row="2" Background="#FFFAF5" CornerRadius="12" Padding="16,12" Margin="0,0,0,14">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Color="#A0522D"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#5D4037" Margin="0,0,0,6">
                        <Run Text="🐾 "/>
                        <Run Text="ハムスターの種類"/>
                    </TextBlock>
                    <ComboBox x:Name="CmbTypes" Height="32" FontSize="13" SelectedIndex="0"
                              SelectionChanged="CmbTypes_SelectionChanged">
                        <ComboBoxItem Content="ゴールデンハムスター" />
                        <ComboBoxItem Content="ジャンガリアンハムスター" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 操作ボタン群 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <Button x:Name="BtnStart" Content="🏃 走らせる" Height="44" Margin="0,0,0,8"
                        Click="BtnStart_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button x:Name="BtnStop" Content="⏹ 停止" Height="44" Margin="0,0,0,8"
                        Click="BtnStop_Click" IsEnabled="False" Style="{StaticResource DangerButtonStyle}"/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnAdd" Content="＋ 追加" Height="40"
                            Click="BtnAdd_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button x:Name="BtnClear" Content="🗑 全削除" Height="40" Grid.Column="2"
                            Click="BtnClear_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>
            </StackPanel>

            <!-- フッターボタン -->
            <Grid Grid.Row="5" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnSettings" Content="⚙ 設定" Height="40"
                        Click="BtnSettings_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="BtnExit" Content="✕ 終了" Height="40" Grid.Column="2"
                        Click="BtnExit_Click" Style="{StaticResource DangerButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
