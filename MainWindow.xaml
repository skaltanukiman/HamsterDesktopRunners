<Window x:Class="HamsterDesktopRunners.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HamsterDesktopRunners Launcher" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Hamster Desktop Runners" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="走らせるディスプレイ:" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbScreens" Height="30" FontSize="14" SelectedIndex="0" SelectionChanged="CmbScreens_SelectionChanged"/>
        </StackPanel>
        
        <Button x:Name="BtnStart" Content="走らせる" Height="40" Margin="0,5" Grid.Row="2" Click="BtnStart_Click" FontSize="16"/>
        <Button x:Name="BtnStop" Content="停止" Height="40" Margin="0,5" Grid.Row="3" Click="BtnStop_Click" IsEnabled="False" FontSize="16"/>
        
        <Grid Grid.Row="4" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAdd" Content="追加" Height="40" Click="BtnAdd_Click" IsEnabled="False" FontSize="16"/>
            <Button x:Name="BtnClear" Content="全削除" Height="40" Grid.Column="2" Click="BtnClear_Click" IsEnabled="False" FontSize="16"/>
        </Grid>
        
        <Button x:Name="BtnExit" Content="終了" Height="40" Margin="0,15,0,0" Grid.Row="5" Click="BtnExit_Click" FontSize="16"/>
    </Grid>
</Window>
