<Window x:Class="HamsterDesktopRunners.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HamsterDesktopRunners Launcher" Height="470" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Hamster Desktop Runners" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="走らせるディスプレイ:" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbScreens" Height="30" FontSize="14" SelectedIndex="0" SelectionChanged="CmbScreens_SelectionChanged"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="ハムスターの種類:" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbTypes" Height="30" FontSize="14" SelectedIndex="0" SelectionChanged="CmbTypes_SelectionChanged">
                <ComboBoxItem Content="ゴールデンハムスター" />
                <ComboBoxItem Content="ジャンガリアンハムスター" />
            </ComboBox>
        </StackPanel>
        
        <Button x:Name="BtnStart" Content="走らせる" Height="40" Margin="0,5" Grid.Row="3" Click="BtnStart_Click" FontSize="16"/>
        <Button x:Name="BtnStop" Content="停止" Height="40" Margin="0,5" Grid.Row="4" Click="BtnStop_Click" IsEnabled="False" FontSize="16"/>
        
        <Grid Grid.Row="5" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAdd" Content="追加" Height="40" Click="BtnAdd_Click" IsEnabled="False" FontSize="16"/>
            <Button x:Name="BtnClear" Content="全削除" Height="40" Grid.Column="2" Click="BtnClear_Click" IsEnabled="False" FontSize="16"/>
        </Grid>
        
        <Grid Grid.Row="6" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSettings" Content="設定" Height="40" FontSize="16" Click="BtnSettings_Click"/>
            <Button x:Name="BtnExit" Content="終了" Height="40" FontSize="16" Grid.Column="2" Click="BtnExit_Click"/>
        </Grid>
    </Grid>
</Window>
